# --- Vapi credentials ---
# Server URL secret. Vapi sends this back as the "X-Vapi-Secret" header
# (or, for newer credential-based auth, as a Bearer token in Authorization).
# We accept either header; both are constant-time compared against this value.
VAPI_SERVER_SECRET=replace-with-a-long-random-string

# Optional: HMAC mode. If set, the webhook also accepts requests whose
# X-Vapi-Signature header is a hex HMAC-SHA256 of the raw request body
# using this key. Enable via VAPI_HMAC_ENABLED=true.
VAPI_HMAC_ENABLED=false
VAPI_HMAC_SECRET=
VAPI_HMAC_HEADER=x-vapi-signature

# Vapi API key — required for assistant provisioning AND outbound calls.
VAPI_API_KEY=

# Phone number ID Vapi will use to dial out (and that the provisioning
# script binds the assistant to with --attach-phone).
VAPI_PHONE_NUMBER_ID=

# Assistant ID returned by `python -m app.assistant ...`. Required for
# outbound calling so we know which assistant to use for the dial.
VAPI_ASSISTANT_ID=

# --- Outbound calling ---
# Bearer credential required to trigger an outbound call via the
# /outbound/call endpoint. Use a long random string. Compared in
# constant time. Distinct from VAPI_SERVER_SECRET on purpose.
OUTBOUND_API_KEY=

# Rate limit on /outbound/call, per source IP.
OUTBOUND_RATE_LIMIT=30/minute

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Rate limit for the webhook (requests per minute per source IP).
WEBHOOK_RATE_LIMIT=120/minute

# --- Supabase ---
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both set, the
# voice agent reads/writes orders and appointments in Supabase
# instead of the in-memory fakes. Leave blank for local dev.
# Use the *service-role* key — server-side only, never the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
