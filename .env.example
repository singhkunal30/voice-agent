# --- Twilio ---
# From console.twilio.com. The auth token is used to sign outbound
# REST calls AND to verify inbound webhook signatures.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# Twilio number we dial out from (E.164).
TWILIO_FROM_NUMBER=+14155550100

# Public HTTPS base URL of this service. Twilio's webhook + media-stream
# URLs must be absolute. For local dev: `ngrok http 8000` -> use the
# https:// URL it prints.
PUBLIC_BASE_URL=https://your-host.example.com

# --- Voice services ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID from elevenlabs.io. Default: "Sarah". Pick a voice that
# sounds right for your brand.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaA
ELEVENLABS_MODEL=eleven_turbo_v2_5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Rate limits, per source IP.
WEBHOOK_RATE_LIMIT=120/minute
OUTBOUND_RATE_LIMIT=30/minute

# --- Outbound calling ---
# Bearer credential required to trigger `/outbound/call`. Long random
# string. Internal credential — distinct from TWILIO_AUTH_TOKEN.
OUTBOUND_API_KEY=

# --- Supabase ---
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both set, orders
# and appointments live in Supabase. Otherwise the in-memory fakes are
# used (data lost on restart). Use the *service-role* key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
